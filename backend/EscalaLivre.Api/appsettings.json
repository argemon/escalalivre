{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Protection": {
    "RequestsPerMinute": 60,
    "SolvesPerMinute": 6,
    "ConcurrentRequests": 8,
    "ConcurrentWorkers": 1,
    "QueueLimit": 2,
    "JobQueueLimit": 20,
    "QueueWaitSeconds": 3,
    "WorkerTimeoutSeconds": 12,
    "WorkerMemoryMb": 512,
    "AllowedOrigins": [],
    "TrustedProxies": []
  }
}
